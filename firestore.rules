rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados privados do usuário — somente ele acessa
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Squads — qualquer autenticado pode ler/criar; só o dono exclui
    match /squads/{squadId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.donoUid == request.auth.uid;
    }

    // Subcoleções do Squad (chat, desafios, membros) — somente autenticados
    // TODO: restringir a membros do squad após implementar campo `memberUids`
    match /squads/{squadId}/{subcol}/{docId} {
      allow read, write: if request.auth != null;
    }

    // Ranking global — leitura pública autenticada; escrita só pelo próprio uid
    match /globalRank/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Personal trainer — dados privados do próprio personal
    match /personals/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Requests de credenciamento — somente o solicitante lê/escreve
    match /personal_requests/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Códigos de convite — qualquer autenticado pode ler para validar; escrita restrita
    match /personal_invites/{code} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Links personal–aluno
    match /personal_links/{linkId} {
      allow read, write: if request.auth != null;
    }

    // Planos criados pelo personal para alunos
    match /personal_plans/{studentUid}/plans/{planId} {
      allow read, write: if request.auth != null;
    }
  }
}
